# UPM Server 환경변수 예시
# 실제 값은 .env 파일에 채워서 사용하세요. (.env는 커밋 금지)

# DB 접속 문자열 (필수). 없으면 서버 기동 실패.
UPM_DB_URL=mysql+pymysql://root:비밀번호@localhost:3306/upm_db

# --- 관리자 웹 로그인(세션 쿠키 인증) ---
# 로그인 아이디/비밀번호. UPM_ADMIN_PASSWORD는 배포 시 반드시 변경할 것.
UPM_ADMIN_USER=admin
UPM_ADMIN_PASSWORD=change-me
# 세션 쿠키 서명 키. 노출 시 세션 위조가 가능하므로 길고 무작위한 값으로 설정할 것.
UPM_SESSION_SECRET=change-me
